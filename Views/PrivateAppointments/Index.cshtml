@model IEnumerable<PsikologProje_Void.ViewModels.AppointmentViewModel>

@{
    ViewData["Title"] = "Özel Randevular";
}

<div class="container app-page">
    <div class="page-header">
        <h1 class="page-title">Özel Randevu Teklifleri</h1>
        <p class="page-subtitle">Doktorunuzun size ozel actigi randevulari buradan kabul veya reddedebilirsiniz.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="app-card text-muted">Bekleyen ozel randevu teklifi bulunmuyor.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <article class="appointment-card h-100">
                        @{
                            var doctorPhoto = string.IsNullOrWhiteSpace(item.DoctorProfilePhotoPath) ? "/images/default-avatar.png" : item.DoctorProfilePhotoPath;
                        }
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <img src="@doctorPhoto" alt="@item.DoctorName" class="doctor-photo" />
                            <div>
                                <h3 class="h6 mb-0">@item.DoctorName</h3>
                                <div class="small text-muted">@item.RelativeDayLabel</div>
                            </div>
                        </div>

                        <div class="small"><b>Tarih:</b> @item.StartTime.ToString("dd.MM.yyyy HH:mm") - @item.EndTime.ToString("HH:mm")</div>
                        <div class="small"><b>Ucret:</b> @item.PriceRange</div>
                        @if (!string.IsNullOrWhiteSpace(item.OfferNoteFromDoctor))
                        {
                            <div class="small"><b>Doktor notu:</b> @item.OfferNoteFromDoctor</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.LocationNote))
                        {
                            <div class="small"><b>Konum notu:</b> @item.LocationNote</div>
                        }

                        @if (item.Location != null)
                        {
                            var destination = $"{item.Location.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)},{item.Location.X.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
                            <a class="btn btn-sm btn-outline-secondary route-link mt-2"
                               data-destination="@destination"
                               target="_blank"
                               rel="noopener noreferrer"
                               href="https://www.google.com/maps/dir/?api=1&destination=@destination&travelmode=driving">
                                <i class="fas fa-directions me-1"></i>Yol Tarifi Al
                            </a>
                        }

                        <form asp-action="Respond" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@item.Id" />
                            <textarea name="responseMessage" rows="2" class="form-control mb-2" placeholder="Doktora notunuz (opsiyonel)"></textarea>
                            <div class="d-flex gap-2">
                                <button type="submit" name="accept" value="true" class="btn btn-sm btn-primary flex-grow-1">Kabul et</button>
                                <button type="submit" name="accept" value="false" class="btn btn-sm btn-outline-danger flex-grow-1">Reddet</button>
                            </div>
                        </form>
                    </article>
                </div>
            }
        </div>
    }
</div>
