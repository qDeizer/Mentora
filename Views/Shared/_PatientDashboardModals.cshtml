@model bool

<div class="modal fade" id="requestModal" tabindex="-1" aria-labelledby="requestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-card">
            <form asp-controller="AppointmentRequest" asp-action="CreateRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="requestModalLabel">Randevu Talebi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="appointmentId" id="modalAppointmentId" />
                    <input type="hidden" name="doctorId" id="modalDoctorId" />
                    <div class="info-callout mb-3">
                        <div><b>Doktor:</b> <span id="requestModalDoctor">-</span></div>
                        <div><b>Randevu:</b> <span id="requestModalTime">-</span></div>
                        <div><b>Tür:</b> <span id="requestModalType">-</span></div>
                        <div><b>Ücret:</b> <span id="requestModalPrice">-</span></div>
                    </div>

                    <div class="mb-3">
                        <label for="reasonForVisit" class="form-label">Başvuru sebebi</label>
                        <textarea id="reasonForVisit" name="reasonForVisit" class="form-control" rows="2" maxlength="500" placeholder="Örn: son dönemde kaygı ve uyku düzeni problemi"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="urgencyLevel" class="form-label">Aciliyet seviyesi</label>
                        <select id="urgencyLevel" name="urgencyLevel" class="form-select">
                            <option value="">Seçmek istemiyorum</option>
                            <option value="Düşük">Düşük</option>
                            <option value="Orta">Orta</option>
                            <option value="Yüksek">Yüksek</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="previousSupportInfo" class="form-label">Daha önce destek aldınız mı?</label>
                        <input id="previousSupportInfo" name="previousSupportInfo" class="form-control" maxlength="300" placeholder="Örn: Daha önce kısa süreli terapi aldım." />
                    </div>

                    <div class="mb-3">
                        <label for="expectations" class="form-label">Görüşmeden beklentiniz</label>
                        <textarea id="expectations" name="expectations" class="form-control" rows="2" maxlength="500" placeholder="Bu görüşmeden ne beklediğinizi kısaca yazabilirsiniz."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Doktora notunuz (isteğe bağlı)</label>
                        <textarea id="message" name="message" class="form-control" rows="3" maxlength="500" placeholder="Talebinizle ilgili ek not yazabilirsiniz."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary">Talep Gönder</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="locationModal" tabindex="-1" aria-labelledby="locationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content app-card">
            <div class="modal-header">
                <h5 class="modal-title" id="locationModalLabel">Randevu Konumu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                @if (Model)
                {
                    <div id="map-modal-body" class="modal-map"></div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">Harita görüntülemek için `GoogleMaps:ApiKey` ayarı gereklidir.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="appointmentsMapModal" tabindex="-1" aria-labelledby="appointmentsMapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content app-card">
            <div class="modal-header">
                <h5 class="modal-title" id="appointmentsMapModalLabel">Filtrelenen Randevular Haritası</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                @if (Model)
                {
                    <div class="map-mode-toolbar mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary map-mode-btn active" data-map-mode="cards">Kartlar</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary map-mode-btn" data-map-mode="pin-name">Pin + İsim</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary map-mode-btn" data-map-mode="pin">Sadece Pin</button>
                    </div>
                    <div id="appointments-map"></div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">Harita görüntülemek için `GoogleMaps:ApiKey` ayarı gereklidir.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="manualLocationPickerModal" tabindex="-1" aria-labelledby="manualLocationPickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content app-card">
            <div class="modal-header">
                <h5 class="modal-title" id="manualLocationPickerModalLabel">Manuel Konum Seçimi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                @if (Model)
                {
                    <input id="manualLocationSearchInput" class="form-control mb-2" type="text" placeholder="Adres ara..." />
                    <div id="manual-location-map" class="modal-map"></div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">Harita seçimi için `GoogleMaps:ApiKey` ayarı gereklidir.</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                @if (Model)
                {
                    <button type="button" class="btn btn-primary" id="manualLocationConfirmBtn" data-bs-dismiss="modal">Konumu Kullan</button>
                }
            </div>
        </div>
    </div>
</div>
