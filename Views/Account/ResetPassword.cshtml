@model PsikologProje_Void.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifreyi Sıfırla";
}

<div class="auth-container">
    <div class="auth-card glass-effect login-card">
        <div class="auth-header">
            <i class="fas fa-shield-alt auth-icon"></i>
            <h2>Yeni Şifre Belirle</h2>
            <p>Hesabınız için yeni bir şifre oluşturun.</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

            <div class="form-floating-group">
                <input asp-for="Password" class="form-control" placeholder="Yeni Şifre" />
                <label asp-for="Password"><i class="fas fa-lock"></i> Yeni Şifre</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-floating-group">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni Şifre Tekrar" />
                <label asp-for="ConfirmPassword"><i class="fas fa-lock"></i> Yeni Şifre Tekrar</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-auth">Şifreyi Güncelle</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
