@model PsikologProje_Void.ViewModels.AutomationDashboardViewModel
@using System.Globalization
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Oto Rutinler";
    var selectedDays = Model.CreateForm.SelectedDays?.ToHashSet() ?? new HashSet<int>();
    var selectedSpecialties = Model.CreateForm.SelectedSpecialtyIds?.ToHashSet() ?? new HashSet<int>();
    var mapsApiKey = Configuration["GoogleMaps:ApiKey"];
    if (string.IsNullOrWhiteSpace(mapsApiKey))
    {
        mapsApiKey = Configuration["GoogleMaps__ApiKey"];
    }
    if (string.IsNullOrWhiteSpace(mapsApiKey))
    {
        mapsApiKey = Configuration["GOOGLE_MAPS_API_KEY"];
    }
    if (string.IsNullOrWhiteSpace(mapsApiKey))
    {
        mapsApiKey = Configuration["GoogleMapsApiKey"];
    }
    var hasMapsApiKey = !string.IsNullOrWhiteSpace(mapsApiKey);
}

<div class="container app-page">
    <div class="page-header">
        <h1 class="page-title">Oto Rutin Yöneticisi</h1>
        <p class="page-subtitle">Rutinlerinizi oluşturun, hızlı hazır seçeneklerle durdurun ve takvim akışına kontrollü şekilde devam edin.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row g-3">
        <div class="col-xl-5">
            <div class="app-card">
                <h2 class="h5 mb-3">Yeni Rutin</h2>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="CreateForm.Name" class="form-label">Rutin adı</label>
                        <input asp-for="CreateForm.Name" class="form-control" />
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="CreateForm.StartTime" class="form-label">Başlangıç saati</label>
                            <input asp-for="CreateForm.StartTime" type="time" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CreateForm.DurationInMinutes" class="form-label">Süre (dk)</label>
                            <input asp-for="CreateForm.DurationInMinutes" type="number" class="form-control" />
                        </div>
                    </div>

                    <div class="mt-2">
                        <label asp-for="CreateForm.GenerateDaysAhead" class="form-label">Kaç gün önce oluşturulsun?</label>
                        <input asp-for="CreateForm.GenerateDaysAhead" type="number" min="1" max="90" class="form-control" />
                        <div class="small text-muted">Örn: 7 seçerseniz sistem sadece sonraki 7 günlük slotları oluşturur.</div>
                    </div>

                    <div class="row g-2 mt-1">
                        <div class="col-md-6">
                            <label asp-for="CreateForm.ActiveFrom" class="form-label">Aktif başlangıç</label>
                            <input asp-for="CreateForm.ActiveFrom" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CreateForm.ActiveUntil" class="form-label">Aktif bitiş</label>
                            <input asp-for="CreateForm.ActiveUntil" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label d-block">Gün seçimi</label>
                        <div class="d-flex flex-wrap gap-2">
                            <label class="btn btn-sm btn-outline-primary"><input type="checkbox" name="CreateForm.SelectedDays" value="1" class="me-1" @(selectedDays.Contains(1) ? "checked" : null) />Pzt</label>
                            <label class="btn btn-sm btn-outline-primary"><input type="checkbox" name="CreateForm.SelectedDays" value="2" class="me-1" @(selectedDays.Contains(2) ? "checked" : null) />Sal</label>
                            <label class="btn btn-sm btn-outline-primary"><input type="checkbox" name="CreateForm.SelectedDays" value="3" class="me-1" @(selectedDays.Contains(3) ? "checked" : null) />Çar</label>
                            <label class="btn btn-sm btn-outline-primary"><input type="checkbox" name="CreateForm.SelectedDays" value="4" class="me-1" @(selectedDays.Contains(4) ? "checked" : null) />Per</label>
                            <label class="btn btn-sm btn-outline-primary"><input type="checkbox" name="CreateForm.SelectedDays" value="5" class="me-1" @(selectedDays.Contains(5) ? "checked" : null) />Cum</label>
                            <label class="btn btn-sm btn-outline-primary"><input type="checkbox" name="CreateForm.SelectedDays" value="6" class="me-1" @(selectedDays.Contains(6) ? "checked" : null) />Cmt</label>
                            <label class="btn btn-sm btn-outline-primary"><input type="checkbox" name="CreateForm.SelectedDays" value="0" class="me-1" @(selectedDays.Contains(0) ? "checked" : null) />Paz</label>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Randevu tipi</label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="CreateForm.IsOnline" />
                            <label class="form-check-label" asp-for="CreateForm.IsOnline">Çevrim içi</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="CreateForm.IsInPerson" />
                            <label class="form-check-label" asp-for="CreateForm.IsInPerson">Yüz yüze</label>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="CreateForm.InPersonLocationMode" class="form-label">Yüz yüze konum kaynağı</label>
                        <select asp-for="CreateForm.InPersonLocationMode" class="form-select" id="createLocationMode">
                            <option value="profile">Profil konumu</option>
                            <option value="device">Mevcut cihaz konumu</option>
                            <option value="manual">Manuel konum girişi</option>
                        </select>
                    </div>

                    <div id="createManualLocationFields" class="row g-2 mt-1">
                        <input asp-for="CreateForm.InPersonLatitude" type="hidden" />
                        <input asp-for="CreateForm.InPersonLongitude" type="hidden" />
                        <div class="col-12">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="createUseDeviceLocationBtn">Cihazdan konum al</button>
                        </div>
                        <div class="col-12">
                            <input id="createManualLocationDisplay" class="form-control" readonly placeholder="Seçilen konum" />
                        </div>
                        @if (hasMapsApiKey)
                        {
                            <div class="col-12">
                                <input id="createManualLocationSearch" class="form-control mb-2" type="text" placeholder="Adres ara..." />
                                <div id="createManualLocationMap" class="modal-map"></div>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">Manuel seçim için GoogleMaps API anahtarı gerekli.</div>
                            </div>
                        }
                    </div>

                    <div class="mt-2 location-note-wrapper">
                        <label asp-for="CreateForm.LocationNote" class="form-label">Açık adres notu</label>
                        <input asp-for="CreateForm.LocationNote"
                               class="form-control"
                               placeholder="Örn: Klinik girişi B blok, 3. kat."
                               data-location-note-history="mentora-location-note-history" />
                    </div>

                    <div class="row g-2 mt-1">
                        <div class="col-md-6">
                            <label asp-for="CreateForm.MinPrice" class="form-label">Min fiyat</label>
                            <input asp-for="CreateForm.MinPrice" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CreateForm.MaxPrice" class="form-label">Max fiyat</label>
                            <input asp-for="CreateForm.MaxPrice" class="form-control" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Uzmanlıklar</label>
                        <div class="row g-2">
                            @foreach (var item in Model.SpecialtyOptions)
                            {
                                var specialtyId = int.Parse(item.Value!, System.Globalization.CultureInfo.InvariantCulture);
                                <div class="col-sm-6">
                                    <label class="form-check border rounded px-2 py-2 w-100 d-flex align-items-center gap-2">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               name="CreateForm.SelectedSpecialtyIds"
                                               value="@specialtyId"
                                               @(selectedSpecialties.Contains(specialtyId) ? "checked" : null) />
                                        <span class="small">@item.Text</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="CreateForm.Notes" class="form-label">Not</label>
                        <textarea asp-for="CreateForm.Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3">Rutini Oluştur</button>
                </form>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="app-card">
                <h2 class="h5 mb-3">Mevcut Rutinler</h2>

                @if (!Model.Routines.Any())
                {
                    <div class="text-muted">Henüz otomatik rutin tanımı yok.</div>
                }
                else
                {
                    foreach (var routine in Model.Routines)
                    {
                        var isPaused = routine.PausedUntilUtc.HasValue && routine.PausedUntilUtc.Value > DateTime.UtcNow;
                        var statusClass = isPaused ? "status-pending" : "status-active";
                        var statusText = isPaused ? "Duraklatıldı" : "Aktif";

                        <article class="content-card mb-2">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <h3 class="h6 mb-1">@routine.Name</h3>
                                    <div class="small text-muted">@routine.DaysText | @routine.TimeRange</div>
                                </div>
                                <span class="status-chip @statusClass">@statusText</span>
                            </div>

                            <div class="entity-meta">
                                <div><b>Tür:</b> @routine.AppointmentTypes</div>
                                <div><b>Ücret:</b> @routine.PriceRange</div>
                                <div><b>Uzmanlık:</b> @string.Join(", ", routine.Specialties)</div>
                                <div><b>Konum kaynağı:</b> @routine.InPersonLocationMode</div>
                                <div><b>Oluşturma ufku:</b> @routine.GenerateDaysAhead gün</div>
                            </div>
                            <div class="small">
                                <b>Dönem:</b> @routine.ActiveFrom.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture) - @(routine.ActiveUntil?.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture) ?? "Sınırsız")
                            </div>
                            @if (isPaused)
                            {
                                <div class="warning-callout">Duraklatma bitiş: @routine.PausedUntilUtc!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(routine.Notes))
                            {
                                <div class="small"><b>Not:</b> @routine.Notes</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(routine.LocationNote))
                            {
                                <div class="small"><b>Konum notu:</b> @routine.LocationNote</div>
                            }

                            <div class="action-row">
                                <a asp-action="Edit" asp-route-id="@routine.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>

                                <form asp-action="Pause" method="post" class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@routine.Id" />
                                    <button type="submit" name="pauseDays" value="1" class="btn btn-sm btn-outline-warning">1g</button>
                                    <button type="submit" name="pauseDays" value="3" class="btn btn-sm btn-outline-warning">3g</button>
                                    <button type="submit" name="pauseDays" value="7" class="btn btn-sm btn-outline-warning">7g</button>
                                    <button type="submit" name="pauseDays" value="30" class="btn btn-sm btn-outline-warning">30g</button>
                                </form>

                                <form asp-action="Resume" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@routine.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Devam et</button>
                                </form>

                                <form asp-action="Delete" method="post" data-confirm="Rutin silinsin mi?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@routine.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </div>

                            <form asp-action="Pause" method="post" class="row g-2 mt-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@routine.Id" />
                                <div class="col-sm-8">
                                    <label class="form-label form-label-sm mb-1">Tarihe kadar durdur</label>
                                    <input type="datetime-local" name="pauseUntilLocal" class="form-control form-control-sm" />
                                </div>
                                <div class="col-sm-4">
                                    <button type="submit" class="btn btn-sm btn-outline-warning w-100">Uygula</button>
                                </div>
                            </form>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (hasMapsApiKey)
    {
        <script async defer src="https://maps.googleapis.com/maps/api/js?key=@mapsApiKey&libraries=places&loading=async"></script>
    }
    <script>
        let createManualMap;
        let createManualMarker;
        let createManualAutocomplete;

        function whenGoogleMapsReady(callback) {
            if (window.google && window.google.maps) {
                callback();
                return;
            }

            const startedAt = Date.now();
            const timer = window.setInterval(function() {
                if (window.google && window.google.maps) {
                    window.clearInterval(timer);
                    callback();
                    return;
                }
                if (Date.now() - startedAt > 10000) {
                    window.clearInterval(timer);
                }
            }, 100);
        }

        function updateCreateLocation(lat, lon) {
            const latInput = document.getElementById("CreateForm_InPersonLatitude");
            const lonInput = document.getElementById("CreateForm_InPersonLongitude");
            const displayInput = document.getElementById("createManualLocationDisplay");
            if (latInput) latInput.value = Number(lat).toFixed(6);
            if (lonInput) lonInput.value = Number(lon).toFixed(6);
            if (displayInput) displayInput.value = `${Number(lat).toFixed(6)}, ${Number(lon).toFixed(6)}`;
        }

        function initCreateManualMap() {
            const mapElement = document.getElementById("createManualLocationMap");
            if (!mapElement) {
                return;
            }

            whenGoogleMapsReady(function() {
                const latInput = document.getElementById("CreateForm_InPersonLatitude");
                const lonInput = document.getElementById("CreateForm_InPersonLongitude");
                const lat = parseFloat(latInput?.value || "");
                const lon = parseFloat(lonInput?.value || "");
                const hasCoordinates = Number.isFinite(lat) && Number.isFinite(lon);
                const initial = hasCoordinates ? { lat: lat, lng: lon } : { lat: 39.925533, lng: 32.866287 };

                if (!createManualMap) {
                    createManualMap = new google.maps.Map(mapElement, {
                        center: initial,
                        zoom: hasCoordinates ? 12 : 6
                    });

                    createManualMarker = new google.maps.Marker({
                        position: initial,
                        map: createManualMap,
                        draggable: true
                    });

                    createManualMarker.addListener("dragend", function(event) {
                        updateCreateLocation(event.latLng.lat(), event.latLng.lng());
                    });

                    createManualMap.addListener("click", function(event) {
                        createManualMarker.setPosition(event.latLng);
                        updateCreateLocation(event.latLng.lat(), event.latLng.lng());
                    });

                    const searchInput = document.getElementById("createManualLocationSearch");
                    if (searchInput) {
                        createManualAutocomplete = new google.maps.places.Autocomplete(searchInput, {
                            fields: ["geometry", "name"]
                        });
                        createManualAutocomplete.addListener("place_changed", function() {
                            const place = createManualAutocomplete.getPlace();
                            if (!place || !place.geometry || !place.geometry.location) {
                                return;
                            }

                            createManualMarker.setPosition(place.geometry.location);
                            updateCreateLocation(place.geometry.location.lat(), place.geometry.location.lng());
                            if (place.geometry.viewport) {
                                createManualMap.fitBounds(place.geometry.viewport);
                            } else {
                                createManualMap.panTo(place.geometry.location);
                                createManualMap.setZoom(14);
                            }
                        });
                    }
                } else {
                    createManualMap.panTo(initial);
                    createManualMarker.setPosition(initial);
                }

                window.setTimeout(function() {
                    google.maps.event.trigger(createManualMap, "resize");
                    createManualMap.panTo(initial);
                }, 120);
            });
        }

        function toggleCreateManualLocationFields() {
            const mode = document.getElementById("createLocationMode")?.value || "profile";
            const isInPerson = document.getElementById("CreateForm_IsInPerson")?.checked;
            const panel = document.getElementById("createManualLocationFields");
            if (!panel) {
                return;
            }
            if (!isInPerson) {
                panel.style.display = "none";
                return;
            }
            panel.style.display = mode === "profile" ? "none" : "";
            if (mode === "manual") {
                initCreateManualMap();
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const modeSelect = document.getElementById("createLocationMode");
            const inPersonSwitch = document.getElementById("CreateForm_IsInPerson");
            const deviceBtn = document.getElementById("createUseDeviceLocationBtn");
            const latInput = document.getElementById("CreateForm_InPersonLatitude");
            const lonInput = document.getElementById("CreateForm_InPersonLongitude");

            toggleCreateManualLocationFields();
            modeSelect?.addEventListener("change", toggleCreateManualLocationFields);
            inPersonSwitch?.addEventListener("change", toggleCreateManualLocationFields);

            deviceBtn?.addEventListener("click", function() {
                if (!navigator.geolocation) {
                    if (window.showMentoraToast) {
                        window.showMentoraToast("Tarayici konum servisini desteklemiyor.", "warning");
                    }
                    return;
                }

                navigator.geolocation.getCurrentPosition(function(pos) {
                    updateCreateLocation(pos.coords.latitude, pos.coords.longitude);
                    if (modeSelect) {
                        modeSelect.value = "device";
                    }
                    toggleCreateManualLocationFields();
                }, function() {
                    if (window.showMentoraToast) {
                        window.showMentoraToast("Cihaz konumu alınamadı.", "warning");
                    }
                });
            });
        });
    </script>
}
